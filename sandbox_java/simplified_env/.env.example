# Copy to .env (ignored by Git), replace passwords, then export for the Java CLI.
# Compose loads .env automatically; Java does not.
RAG_POSTGRES_PASSWORD=replace-admin-password
RAG_IMPORT_DB_PASSWORD=replace-import-password
RAG_DB_PASSWORD=replace-reader-password
RAG_DB_PORT=55432
RAG_IMPORT_DB_URL=jdbc:postgresql://localhost:55432/trade_analysis
RAG_IMPORT_DB_USER=rag_import
RAG_DB_URL=jdbc:postgresql://localhost:55432/trade_analysis
RAG_DB_USER=rag_reader
